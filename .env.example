# --- Modelo (Gemini via AI Studio) ---------------------------------------
# Sem chave, o simulador roda em modo --offline (LLM scriptado).
GEMINI_API_KEY=
MODEL=gemini-3.8-flash

# --- Custo estimado (A CONFIRMAR: preços de exemplo, em USD por 1M tokens) --
PRICE_INPUT_PER_1M_USD=0.30
PRICE_OUTPUT_PER_1M_USD=2.50
USD_BRL=5.50

# --- Outros ---------------------------------------------------------------
DB_PATH=data/telemetria.db
TTFT_META_MS=2000
TZ_NAME=America/Sao_Paulo
